# ─────────────────────────────────────────────────────────────────────────────
# CompareZ Backend Environment Configuration (.env)
# ─────────────────────────────────────────────────────────────────────────────

# ─── AI Service (Groq) ────────────────────────────────────────────────────────
# Get your free API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Database (PostgreSQL / Neon) ─────────────────────────────────────────────
# Neon cloud or local postgres
DATABASE_URL=postgresql://user:password@localhost:5432/pricepilot?sslmode=disable

# ─── Cache (Redis) ────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379

# ─── Auth & Security ──────────────────────────────────────────────────────────
# Minimum 32 characters required
JWT_SECRET=replace_with_a_secure_32_character_random_secret_key!
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ─── Search Engine (Meilisearch) ──────────────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey

# ─── Server Port ──────────────────────────────────────────────────────────────
PORT=8080
